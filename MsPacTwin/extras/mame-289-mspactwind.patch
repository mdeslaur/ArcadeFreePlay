@@ -3861,6 +3868,19 @@ void mspactwin_state::mspactwin(machine_
 	GENERIC_LATCH_8(config, m_sublatch);
 }
 
+void mspactwin_state::mspactwind(machine_config &config)
+{
+	mspacman(config);
+
+	// Basic machine hardware
+	m_maincpu->set_addrmap(AS_PROGRAM, &mspactwin_state::mspactwin_map);
+	m_maincpu->set_addrmap(AS_OPCODES, &mspactwin_state::mspactwind_decrypted_map);
+
+	m_mainlatch->q_out_cb<3>().set(FUNC(mspactwin_state::flipscreen_w));
+
+	GENERIC_LATCH_8(config, m_sublatch);
+}
